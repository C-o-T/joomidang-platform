<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.joomidang.backend.user.mapper.UserMapper">

    <resultMap id="user" type="com.joomidang.backend.user.dto.UserDTO">
        <id     column="id"                 property="id" />
        <result column="email"              property="email" />
        <result column="password"           property="password" />
        <result column="name"               property="name" />
        <result column="role"               property="role" />
        <result column="country"            property="country" />
        <result column="phone"              property="phone" />
        <result column="birth_date"         property="birthDate" />
        <result column="age_verified"       property="ageVerified" />
        <result column="preferred_language" property="preferredLanguage" />
        <result column="created_at"         property="createdAt" />
        <result column="updated_at"         property="updatedAt" />
    </resultMap>

    <!-- 회원가입 -->
    <insert id="insertUser">
        INSERT INTO users (
            email
            , password
            , name
            , role
            , country
            , phone
            , birth_date
            , preferred_language
        ) VALUES (
            #{email}
            , #{password}
            , #{name}
            , IFNULL(#{role}, 'CONSUMER')
            , #{country}
            , #{phone}
            , #{birthDate}
            , IFNULL(#{preferredLanguage}, 'en')
        )
    </insert>

    <!-- 이메일 중복 확인 -->
    <select id="checkEmail" resultType="String">
        SELECT email
        FROM users
        WHERE email = #{email}
        AND is_deleted = 0
    </select>

    <!-- 이메일로 회원 조회 (BCrypt 비밀번호 검증용 - password 해시 포함) -->
    <select id="findByEmail" resultMap="user">
        SELECT id
             , email
             , password
             , name
             , role
             , country
             , preferred_language
        FROM users
        WHERE email = #{email}
          AND is_deleted = 0
    </select>

    <!-- 회원 단건 조회 -->
    <select id="getUserById" resultMap="user">
        SELECT id
             , email
             , name
             , role
             , country
             , phone
             , preferred_language
             , created_at
        FROM users
        WHERE id = #{id}
          AND is_deleted = 0
    </select>

</mapper>
