<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.joomidang.backend.order.mapper.OrderItemMapper">

    <resultMap id="orderItem" type="com.joomidang.backend.order.dto.OrderItemDTO">
        <id     column="id"             property="id" />
        <result column="order_id"       property="orderId" />
        <result column="product_id"     property="productId" />
        <result column="seller_id"      property="sellerId" />
        <result column="quantity"       property="quantity" />
        <result column="price_at_order" property="priceAtOrder" />
        <result column="currency"       property="currency" />
        <result column="created_at"     property="createdAt" />
    </resultMap>

    <!-- 주문 상품 저장 -->
    <insert id="insertOrderItem">
        INSERT INTO order_items (
            order_id
            , product_id
            , seller_id
            , quantity
            , price_at_order
            , currency
        ) VALUES (
            #{orderId}
            , #{productId}
            , #{sellerId}
            , #{quantity}
            , #{priceAtOrder}
            , IFNULL(#{currency}, 'USD')
        )
    </insert>

    <!-- 주문별 상품 목록 조회 -->
    <select id="getOrderItemListByOrderId" resultMap="orderItem">
        SELECT id
             , order_id
             , product_id
             , seller_id
             , quantity
             , price_at_order
             , currency
             , created_at
        FROM order_items
        WHERE order_id = #{orderId}
    </select>

</mapper>
