<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.joomidang.backend.cart.mapper.CartMapper">

    <!--
        products 테이블과 JOIN해서 상품명/가격/카테고리를 함께 반환
        cart_items에는 가격을 저장하지 않으므로 항상 최신 가격(price_krw)을 가져옴
    -->
    <resultMap id="cart" type="com.joomidang.backend.cart.dto.CartDTO">
        <id     column="id"           property="id" />
        <result column="user_id"      property="userId" />
        <result column="product_id"   property="productId" />
        <result column="seller_id"    property="sellerId" />
        <result column="quantity"     property="quantity" />
        <result column="product_name" property="productName" />
        <result column="name_en"      property="nameEn" />
        <result column="name_ja"      property="nameJa" />
        <!-- name_zh: product-schema-extension.sql 실행 후 SELECT + resultMap에 추가 -->

        <result column="price"        property="price" />
        <result column="category"     property="category" />
        <result column="created_at"   property="createdAt" />
    </resultMap>

    <!-- 장바구니 추가 -->
    <insert id="insertCart">
        INSERT INTO cart_items (
            user_id
            , product_id
            , quantity
        ) VALUES (
            #{userId}
            , #{productId}
            , #{quantity}
        )
    </insert>

    <!-- 동일 (userId + productId) 항목 조회 - 중복 추가 방지 upsert 판단용 -->
    <select id="findByUserAndProduct" resultMap="cart">
        SELECT c.id
             , c.user_id
             , c.product_id
             , c.quantity
        FROM cart_items c
        WHERE c.user_id = #{userId}
          AND c.product_id = #{productId}
        LIMIT 1
    </select>

    <!-- 장바구니 목록 조회 - products 테이블과 JOIN해서 상품명/가격 포함 -->
    <select id="getCartListByUserId" resultMap="cart">
        SELECT c.id
             , c.user_id
             , c.product_id
             , p.seller_id
             , c.quantity
             , p.name_ko   AS product_name
             , p.name_en
             , p.name_ja
             , p.price_krw AS price
             , p.category
             , c.created_at
        FROM cart_items c
        INNER JOIN products p ON c.product_id = p.id
        WHERE c.user_id = #{userId}
          AND p.deleted_at IS NULL
        ORDER BY c.created_at DESC
    </select>

    <!-- 장바구니 수량 수정 -->
    <update id="updateCartQuantity">
        UPDATE cart_items
        SET quantity = #{quantity}
        WHERE id = #{id}
    </update>

    <!-- 장바구니 항목 삭제 -->
    <delete id="deleteCart">
        DELETE FROM cart_items
        WHERE id = #{id}
    </delete>

    <!-- 장바구니 전체 비우기 (주문 완료 후 호출) -->
    <delete id="deleteCartByUserId">
        DELETE FROM cart_items
        WHERE user_id = #{userId}
    </delete>

</mapper>
